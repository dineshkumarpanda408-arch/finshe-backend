{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "distribution/hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.apk",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"FinShe-release.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          }
        ]
      }
    ]
  }
}
